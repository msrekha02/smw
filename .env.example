# Everything here is optional. `docker compose up` with none of it set boots a
# fully working product on the replay providers.

# --- database -------------------------------------------------------------
# API uses the pooled URL; the worker uses the DIRECT one (port 5432).
# Supabase's pooler runs pgbouncer in transaction mode, where session-scoped
# behaviour is unreliable.
DATABASE_URL=postgresql+asyncpg://smw:smw@postgres:5432/smw
DATABASE_URL_DIRECT=postgresql+asyncpg://smw:smw@postgres:5432/smw

# --- redis ----------------------------------------------------------------
# Locks live in their own logical DB, configured noeviction. Under allkeys-lru
# the lock keys are evictable and stampede protection silently stops working
# under memory pressure -- exactly when it is needed.
REDIS_URL=redis://redis:6379/0
REDIS_LOCK_URL=redis://redis:6379/1

# --- auth -----------------------------------------------------------------
# Leave SUPABASE_JWKS_URL unset and /login signs in any email with a local
# HS256 token. Set it and that path returns 404: tokens then come from Supabase
# and are verified against the project's JWKS. Exactly one is ever live.
# The local issuer also refuses to run in live provider mode.
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
DEV_AUTH_SECRET=dev-insecure-local-only

# Must come from the environment, never generated at boot: one API instance
# issues a digest token and another has to verify it.
DIGEST_TOKEN_SECRET=dev-insecure-local-only

# --- providers ------------------------------------------------------------
# Omit either key and that half falls back to replay, and says so in /healthz.
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
PROVIDER_MODE=replay

# --- replay ---------------------------------------------------------------
# baseline | market_crash | single_name | spike_revert
REPLAY_SCENARIO=baseline
# compressed maps the real 24h clock onto the scenario session so the demo is
# always live; passthrough keeps the real time of day; pinned freezes at
# REPLAY_NOW (what the tests use).
REPLAY_CLOCK=compressed
REPLAY_NOW=

# --- demo -----------------------------------------------------------------
SEED_DEMO=1
DEMO_EMAIL=you@example.com
# Defaults to whatever window the active scenario declares.
DEMO_BACK_SESSIONS=

LOG_LEVEL=INFO
CORS_ORIGINS=*
